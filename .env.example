# Database Configuration
DATABASE_URL=postgresql://flyrank_user:postgres_password@postgres:5432/flyrank_billing
POSTGRES_PASSWORD=postgres_password

# Stripe Configuration (Test Mode)
STRIPE_API_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# Application Configuration
APP_NAME=FlyRank Billing Engine
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
DEBUG=true
LOG_LEVEL=info

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost"]

# API Configuration
API_TITLE=FlyRank Metering & Billing Engine
API_VERSION=0.1.0

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Environment
ENVIRONMENT=development
